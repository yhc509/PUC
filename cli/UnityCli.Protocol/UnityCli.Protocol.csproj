<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="*.cs" />
    <Compile Include="..\..\unity-package\com.yhc509.unity-cli-bridge\Runtime\Protocol\*.cs"
             Link="Protocol\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidateSharedProtocolSourceLocation" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <LocalProtocolSource Include="$(MSBuildProjectDirectory)/*.cs" />
    </ItemGroup>
    <Error Condition="'@(LocalProtocolSource)' != ''"
           Text="Protocol files must live in unity-package/com.yhc509.unity-cli-bridge/Runtime/Protocol/, not in cli/UnityCli.Protocol/. Found: @(LocalProtocolSource->'%(FullPath)', ', ')" />
  </Target>

</Project>
